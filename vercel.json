{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/owner",
      "destination": "https://black-lantern-cycle.keithparker1901.chatgpt.site/owner/manuscripts",
      "permanent": false
    },
    {
      "source": "/owner/",
      "destination": "https://black-lantern-cycle.keithparker1901.chatgpt.site/owner/manuscripts",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/owner",
      "headers": [
        {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive, nosnippet"},
        {"key":"Cache-Control","value":"private, no-store, max-age=0"}
      ]
    },
    {
      "source": "/owner/",
      "headers": [
        {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive, nosnippet"},
        {"key":"Cache-Control","value":"private, no-store, max-age=0"}
      ]
    },
    {"source": "/(.*)", "headers": [
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:"}
    ]}
  ]
}